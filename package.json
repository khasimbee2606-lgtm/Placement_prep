{
  "name": "placement-preparation-tracker",
  "version": "1.0.0",
  "description": "Placement Preparation Tracker - Complete MERN Stack Application",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "start": "node backend/server.js",
    "build": "npm --prefix frontend run build",
    "install-all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "mern",
    "placement-tracker",
    "react",
    "node",
    "mongodb-atlas",
    "jwt",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
